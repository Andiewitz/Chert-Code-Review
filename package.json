{
  "name": "chert",
  "version": "0.4.0",
  "description": "A CLI tool built with Bun",
  "type": "module",
  "bin": {
    "chert": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "smoke": "bun run scripts/smoke-tui.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@opentui/core": "^0.9.0",
    "@opentui/solid": "^0.9.0",
    "solid-js": "^1.9.12",
    "web-tree-sitter": "0.25.10"
  }
}
